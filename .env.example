# Copy this file to .env and edit it locally.
# .env is ignored by git and must never be committed.

# Flask server
PORT=5000
FLASK_DEBUG=0

# Session signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FEDHEALTH_SECRET_KEY=replace-with-a-long-random-string

# Optional: only needed to run NEW paid LLM audits (fedauditor.run_audit / run_audit_grid --agents claude).
# The app, tests, walkthrough and paper all work without it.
# ANTHROPIC_API_KEY=your-key-here
